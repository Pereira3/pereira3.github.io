{
	"name": "personal-site",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"typecheck": "tsc -b",
		"lint": "oxlint --deny-warnings",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"preview": "vite preview",
		"prepare": "husky"
	},
	"dependencies": {
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"lucide-react": "^1.49.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-icons": "^5.7.0",
		"react-router": "^8.4.0"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"oxlint": "^1.81.0",
		"prettier": "3.9.9",
		"typescript": "~6.0.2",
		"vite": "^8.3.0"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": "oxlint --deny-warnings",
		"*": "prettier --write --ignore-unknown"
	}
}
